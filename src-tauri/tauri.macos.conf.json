{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeaLantern Connect",
        "width": 1200,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ]
  },
  "bundle": {
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 198
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 198
        }
      }
    }
  }
}
