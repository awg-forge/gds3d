{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeaLantern Connect",
        "width": 1200,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 625,
        "center": true,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
