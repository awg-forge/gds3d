{
  "name": "gds3d",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/KercyDing/gds3d",
  "type": "module",
  "scripts": {
    "dev": "vite dev -c src/vite.config.ts",
    "build": "vite build -c src/vite.config.ts",
    "preview": "vite preview",
    "test": "svelte-check --workspace . --tsconfig src/tsconfig.json",
    "sv": "node scripts/version.ts show",
    "cv": "node scripts/version.ts change",
    "tauri": "tauri",
    "lint": "oxlint -c src/.oxlintrc.json src scripts",
    "lint:fix": "oxlint -c src/.oxlintrc.json --fix src scripts",
    "fmt": "oxfmt -c src/.oxfmtrc.json src scripts package.json pnpm-workspace.yaml README.md",
    "fmt:check": "oxfmt -c src/.oxfmtrc.json --check src scripts package.json pnpm-workspace.yaml README.md"
  },
  "dependencies": {
    "@babylonjs/core": "^9",
    "@babylonjs/serializers": "^9",
    "@lucide/svelte": "^1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "bits-ui": "^2.19.0",
    "earcut": "^3",
    "svelte": "^5",
    "svelte-awesome-color-picker": "^4",
    "svelte-sonner": "^1.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tauri-apps/cli": "^2",
    "oxfmt": "^0.64",
    "oxlint": "^1",
    "svelte-check": "^4",
    "typescript": "^6",
    "vite": "^8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
