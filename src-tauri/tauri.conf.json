{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeaLantern Connect",
  "version": "1.0.0",
  "identifier": "com.sealantern.connect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SeaLantern Connect",
        "width": 1200,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 625,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 SeaLantern-Studio",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sculk"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNTcwRjk1MERFMUFFOQpSV1RwR3Q1UStYRGxEbW02cjB5TzU3YjFCTEVYYTVrMkJsMmdkakFDNXozVThLR3J5UWU5R1owcgo=",
      "endpoints": [
        "https://cnb.cool/SeaLantern-studio/SeaLantern-Connect/-/git/raw/updater/latest.json",
        "https://github.com/SeaLantern-Studio/SeaLantern-Connect/releases/latest/download/latest.json"
      ]
    }
  }
}
