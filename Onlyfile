# Run `only` to list all tasks
# Documentation: https://github.com/KercyDing/only
# Install: `cargo install only`
# VS Code extension: kercyding.onlyfile

!version 0.4

[help] Start development mode
dev() ? @os("windows") shell~=pwsh:
    pnpm tauri dev

dev():
    pnpm tauri dev

[help] Build the application
build() ? @os("macos"):
    pnpm tauri build
    bash scripts/makedmg.sh

build():
    pnpm tauri build

[help] Run the full CI suite
[desc] Run frontend and backend CI in parallel.
[pass] Local CI passed.
ci() & (front.ci, back.ci)

[help] Run all checks
[pass] Formatting and checks passed.
check() & (front.check, back.check)

[help] Run all tests
[pass] Tests passed.
test() & (front.test, back.test)

[help] Clean all build artifacts
[pass] Build artifacts cleaned.
clean() & (front.clean, back.clean)

[help] Check the development environment
[pass] Development environment ready.
_prepare() & (front._prepare, back._prepare)

# =============== Frontend ===============
[help] Frontend tasks
group front {

    [help] Prepare the frontend environment
    _prepare() ? @has("pnpm"):
        pnpm install

    [fail] pnpm is required.
    _prepare():
        exit 1

    [help] Format and check the frontend
    [pass] Frontend checks passed.
    [fail] Frontend checks failed.
    check() & _prepare:
        pnpm fmt
        pnpm lint

    [help] Run frontend tests
    [pass] Frontend tests passed.
    [fail] Frontend tests failed.
    test() & _prepare:
        pnpm test

    [help] Run frontend CI
    [pass] Frontend CI passed.
    ci() & (check, test)

    [help] Clean frontend build artifacts
    [pass] Frontend artifacts cleaned.
    [fail] Failed to clean frontend artifacts.
    clean():
        rm -rf node_modules dist
}

# =============== Backend ===============
[help] Backend tasks
group back {

    [help] Prepare the backend environment
    [pass] Backend environment ready.
    _prepare() ? @has("cargo")

    [fail] cargo is required.
    _prepare():
        exit 1

    [help] Format and check the backend
    [pass] Backend checks passed.
    [fail] Backend checks failed.
    check() & _prepare:
        cargo fmt --all
        cargo check --workspace --all-targets
        cargo clippy --workspace --all-targets -- -D warnings

    [help] Run backend tests
    [pass] Backend tests passed.
    [fail] Backend tests failed.
    test() ? @has("cargo-nextest") & _prepare:
        cargo nextest run --no-fail-fast

    test() & _prepare:
        cargo test --all-targets --workspace

    [help] Run backend CI
    [pass] Backend CI passed.
    ci() & check & test

    [help] Clean backend build artifacts
    [pass] Backend artifacts cleaned.
    [fail] Failed to clean backend artifacts.
    clean():
        cargo clean
}

# =============== Versioning ===============
[help] Versioning tasks
group version {

    [help] Show the project version
    show():
        pnpm sv

    [help] Publish a new version
    [desc] Only administrators can run this task.
    [pass] Release published.
    [fail] Invalid version.
    publish(version):
        pnpm cv {{version}}
        only ci
        git commit -am "chore: update to {{version}}"
        git tag {{version}}
        git push --atomic origin HEAD {{version}}
}
