{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "import/named": ["error"],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss", "**/*.less"]
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx", ".svelte", ".css"]
      },
      "typescript": {
        "alwaysTryTypes": true,
        "project": "./src/tsconfig.json"
      },
      "alias": {
        "map": [
          ["@", "./src"],
          ["@components", "./src/components"],
          ["@i18n", "./src/i18n"],
          ["@domain", "./src/domain"],
          ["@themes", "./src/themes"],
          ["@models", "./src/models"]
        ],
        "extensions": [".js", ".jsx", ".ts", ".tsx", ".svelte"]
      }
    },
    "import/parsers": {
      "@typescript-eslint/parser": [".ts", ".tsx", ".svelte"]
    },
    "jsx-a11y": {
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludeFiles": ["api/**/*.ts", "lib/state.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@tauri-apps/*", "@api/*", "**/api/*"]
          }
        ]
      }
    },
    {
      "files": ["**/*.svelte"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@tauri-apps/*"]
          }
        ]
      }
    }
  ],
  "globals": {}
}
